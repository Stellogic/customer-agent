{
  "name": "customer-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:bundle": "vite build",
    "bundle:evidence": "node scripts/assert-bundle-evidence.mjs",
    "build": "npm run typecheck && npm run build:bundle && npm run bundle:evidence",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:bundle && npm run bundle:evidence"
  },
  "dependencies": {
    "@ant-design/pro-components": "3.1.14-6",
    "@ant-design/x": "2.9.0",
    "antd": "6.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.10.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.0"
  }
}
