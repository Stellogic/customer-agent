POSTGRES_SUPERUSER_PASSWORD=local-postgres-superuser
SPRING_TO_AGENT_TOKEN=local-spring-to-agent
AGENT_PROBE_CONNECT_TIMEOUT=500ms
AGENT_PROBE_READ_TIMEOUT=1s
AGENT_MACHINE_TOKEN=local-agent-machine
EXECUTOR_MACHINE_TOKEN=local-executor-machine

# 正式模式四个角色统一使用 Pro；默认固定模型模式不产生供应商调用。
DEEPSEEK_MODEL=deepseek-v4-pro
